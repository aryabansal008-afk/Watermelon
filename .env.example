# Never commit .env. Database credentials are only read by Python.
# Normal queries use the pooled endpoint. Alembic, backups, and session-sensitive work use the direct endpoint.
DATABASE_URL=postgresql+psycopg://watermelon:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/watermelon
DATABASE_URL_UNPOOLED=postgresql+psycopg://watermelon:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/watermelon

# Docker Compose uses these URLs from container network. Set both to local `postgres` URLs
# (or Neon pooled/direct URLs when using Neon instead of the local Postgres service).
DOCKER_DATABASE_URL=postgresql+psycopg://watermelon:REPLACE_WITH_LOCAL_PASSWORD@postgres:5432/watermelon
DOCKER_DATABASE_URL_UNPOOLED=postgresql+psycopg://watermelon:REPLACE_WITH_LOCAL_PASSWORD@postgres:5432/watermelon
LOCAL_POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_LOCAL_PASSWORD

# Optional dedicated PostgreSQL integration test database. Must end with _test.
TEST_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0
API_BASE_URL=http://127.0.0.1:8000

# Generate independent random values of at least 32 characters.
API_SERVICE_TOKEN=
SESSION_SECRET=
OWNER_PASSWORD=
OWNER_ID=local-owner
APP_ENV=development
APP_ORIGIN=http://localhost:3000

GITHUB_TOKEN=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_INSTALLATION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_PUBLISH_ENABLED=false

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VERIFY_MODEL=openai/gpt-4o-mini
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small

MODEL_CALLS_PER_DAY=30
MODEL_MAX_OUTPUT_TOKENS=3500
MODEL_MAX_INPUT_CHARS=48000
JOBS_PER_PROJECT_PER_HOUR=12
DISCOURSE_ORIGINS=https://discuss.python.org
