FROM python:3.13-slim
WORKDIR /app
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock ./
COPY backend ./backend
RUN uv sync --frozen --no-dev
COPY alembic.ini ./
COPY migrations ./migrations
COPY data ./data
COPY scripts ./scripts
RUN useradd --create-home watermelon && chown -R watermelon /app
USER watermelon
EXPOSE 8000
CMD [".venv/bin/uvicorn", "backend.api:app", "--host", "0.0.0.0", "--port", "8000"]
